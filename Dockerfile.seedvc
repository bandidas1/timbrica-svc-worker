# seed-vc singing-voice-conversion serverless worker for RunPod.
# Base: python:3.11-slim — torch's cu124 wheels bundle the CUDA runtime libs, so we
# only need the host NVIDIA driver (RunPod provides it). Mirrors the shape of
# timbrica-qwen-tts-worker.
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    SEED_VC_DIR=/seed-vc

# System libs: libsndfile for soundfile, ffmpeg for librosa/pydub decode,
# libgomp for numpy/scipy OpenMP, git to fetch seed-vc.
# build-essential: a few deps (e.g. resemblyzer→webrtcvad) ship source-only wheels.
# The spike ran on RunPod's *devel* base which already had a compiler; python:slim
# does not, so add one rather than discover it 40 minutes into a CI build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg libgomp1 ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*

# torch 2.7.1 / CUDA 12.8 — and the CUDA version is the point.
#
# Measured 2026-08-18: RunPod fills this account's GPU CLASSES with slices of
# "NVIDIA RTX PRO 6000 Blackwell Server Edition MIG" (sm_120), and images built
# against CUDA <= 12.4 carry no kernels for it. The stem-split worker showed the
# whole shape: its endpoint sat with workers permanently "initializing" and jobs
# undispatched, and recovered the moment its image moved to CUDA 12.8 — nothing
# else changed. Both SVC endpoints are in exactly that state, and /voice-cover
# logged 22 `svc_timeout` failures in August, 21 of them on the two days the
# splitter began failing the same way.
#
# The GPU allow-list cannot fix this: it holds CLASSES, RunPod puts new cards in
# them, and widening seedvc's list from 4 to 8 types changed nothing (measured).
#
# ⚠️ seed-vc upstream pins the 2.4.x line, so running it on 2.7 is a deliberate
# trade. If the model stops loading, the worker now SAYS so (gpu_probe host
# report) instead of hanging — which is the state it is in today.
RUN pip install --no-cache-dir \
        torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 \
        --index-url https://download.pytorch.org/whl/cu128

# seed-vc itself (GPLv3 — executed only on our own GPU, never distributed).
# Pinned to a commit so a silent upstream change can never alter a paid result.
ARG SEED_VC_REF=51383efd921027683c89e5348211d93ff12ac2a8
RUN git clone https://github.com/Plachtaa/seed-vc.git /seed-vc \
    && cd /seed-vc && git checkout "$SEED_VC_REF" && rm -rf .git

COPY requirements-seedvc.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Bake every checkpoint into the image → reliable, fast cold starts.
# Non-fatal: if the CPU builder can't load them, they download on first boot.
COPY bake_seedvc.py /tmp/bake_seedvc.py
RUN python /tmp/bake_seedvc.py || echo "weight bake skipped (will download on first boot)"

# Pre-init the Perth watermarker so its weights are baked too.
RUN python -c "import perth; perth.PerthImplicitWatermarker(); print('perth baked')" || echo "perth build-init skipped"

COPY svc_io.py /svc_io.py
COPY gpu_probe.py /gpu_probe.py
COPY handler_seedvc.py /handler.py
CMD ["python", "-u", "/handler.py"]
